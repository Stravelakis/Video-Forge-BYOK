{
  "name": "video-forge",
  "version": "0.4.0-beta.1",
  "description": "Video Forge — deterministic desktop video production machine",
  "author": "Stravelakis",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "job": "electron . --job",
    "sfx": "electron . --sfx",
    "sfx:free": "electron . --sfx-free",
    "build-exe": "node scripts/build-exe.mjs",
    "build-exe:public": "node scripts/build-exe.mjs --public",
    "build-exe:check": "node scripts/build-exe.mjs --check",
    "personal": "node scripts/personal-content.mjs",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "outros": "electron . --add-outros",
    "brand": "node tools/use-brand.mjs",
    "test": "node --test tools/lib/forgeLink.test.mjs tools/lib/brand.test.mjs tools/lib/migrateUserData.test.mjs tools/lib/scriptMatch.test.mjs tools/lib/greekAccents.test.mjs tools/lib/mediaCache.test.mjs tools/lib/forgeKeys.test.mjs tools/lib/sharedKeysSafety.test.mjs tools/lib/forgeShelf.test.mjs tools/lib/sheet.test.mjs tools/lib/hoverHelp.test.mjs tools/lib/forgeHub.test.mjs tools/lib/ipcSurface.test.mjs tools/lib/pathGuard.test.mjs tools/lib/paidVoice.test.mjs tools/lib/work.test.mjs tools/lib/vaultFile.test.mjs tools/lib/partFile.test.mjs tools/lib/projectFile.test.mjs tools/lib/projectRestore.test.mjs tools/lib/renderSafety.test.mjs tools/lib/characterVoice.test.mjs tools/lib/characterFiles.test.mjs tools/lib/creatorEdit.test.mjs tools/lib/history.test.mjs tools/lib/moveTracks.test.mjs tools/lib/popTracks.test.mjs tools/lib/suggestDirections.test.mjs tools/lib/keyRing.test.mjs tools/lib/customSets.test.mjs tools/lib/rooms.test.mjs tools/lib/flowPrompts.test.mjs tools/lib/captionStyles.test.mjs tools/lib/spliceLine.test.mjs tools/lib/subtitlePages.test.mjs tools/lib/buildKind.test.mjs tools/lib/personalContent.test.mjs tools/lib/updateCheck.test.mjs tools/lib/postProduction.test.mjs tools/lib/ffmpegChoice.test.mjs tools/lib/ffmpegBundle.test.mjs tools/lib/kenneyAvailable.test.mjs explainer/explainer.test.mjs explainer/sfx.test.mjs characters/characters.test.mjs characters/moves.test.mjs characters/profile.test.mjs characters/motion.test.mjs characters/creator.test.mjs characters/marks.test.mjs characters/aibox.test.mjs",
    "test:link": "node --test tools/lib/forgeLink.test.mjs",
    "test:explainer": "node --test explainer/explainer.test.mjs",
    "test:characters": "node --test characters/characters.test.mjs",
    "docs:move-tags": "node tools/move-tags.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@remotion/bundler": "^4.0.540",
    "@remotion/renderer": "^4.0.540",
    "@remotion/transitions": "^4.0.540",
    "esbuild": "^0.28.2",
    "framer-motion": "^14.9.1",
    "hyperframes": "^0.9.16",
    "pdfjs-dist": "4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540",
    "three": "0.170.0",
    "ws": "^8.22.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "zod": "^4.6.6",
    "hyperframes": {
      "undici": "^7.30.1"
    }
  },
  "build": {
    "appId": "com.stravelakis.videoforge",
    "productName": "Video Forge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "out/**",
      "characters/core/**",
      "characters/samples/kenney/builder/**",
      "remotion/**",
      "explainer/**",
      "!explainer/checks/**",
      "tools/lib/explainer*.mjs",
      "characters/**",
      "!characters/checks/**",
      "tools/character-index.mjs",
      "src/**",
      "puppet/**",
      "brands/**",
      "brand.local.json",
      "music/**",
      "sfx/library/**",
      "presets/**",
      "tools/windows-ca-bundle.pem",
      "tsconfig.json",
      "package.json",
      "NOTICE",
      "!**/*.map",
      "!release/**",
      "!piper-venv/**",
      "!stableaudio-venv/**",
      "!models/**",
      "!dramabox-audition/**",
      "!viseme*/**",
      "!voice-refs/**",
      "!jobs/**",
      "!docs/**",
      "!inspiration looks/**",
      "!brands/*/intros/**",
      "!brands/*/outros/**",
      "!brands/*/banners/**",
      "!brands/*/presets/**",
      "!scripts/**"
    ],
    "extraResources": [
      {
        "from": "build/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "LICENSE.txt",
          "README.txt"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Forge",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "video-forge-portable.exe"
    }
  }
}
